{
  "manifest_version": 3,
  "name": "Chrome Smart Translation Assistant",
  "version": "0.1.0",
  "description": "Professional translation with bilingual display, accurate technical terms, and privacy-focused design.",

  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],

  "host_permissions": [
    "https://*/*"
  ],

  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },

  "options_page": "options/options.html",

  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "js": ["content/content.js"],
      "css": ["content/content.css", "content/floating-button.css"],
      "run_at": "document_idle"
    }
  ],

  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },

  "web_accessible_resources": [
    {
      "resources": ["assets/*"],
      "matches": ["https://*/*"]
    }
  ]
}
