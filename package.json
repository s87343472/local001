{
  "name": "chrome-smart-translation-assistant",
  "version": "0.1.0",
  "description": "E2E tests for Chrome translation extension",
  "scripts": {
    "test:e2e": "node tests/e2e/reddit-translation.test.js",
    "test:unit": "jest --testMatch='**/tests/unit/**/*.test.js'",
    "test:all": "npm run test:unit && npm run test:e2e"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testMatch": ["**/tests/unit/**/*.test.js"],
    "collectCoverageFrom": [
      "extension/lib/**/*.js",
      "!extension/lib/*-es6.js"
    ]
  },
  "devDependencies": {
    "puppeteer": "^21.0.0"
  },
  "keywords": ["chrome-extension", "translation", "testing"],
  "author": "",
  "license": "MIT"
}
